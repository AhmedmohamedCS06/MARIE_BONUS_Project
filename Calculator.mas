IF12,       Load UserInput
          	Subt Twelve
          	SkipCond 400
          	Jump IF13
			LoadI ptr1
			store tempptr1
			LoadI ptr2
			Store tempptr2
			Load tempptr1
			Subt tempptr2
			StoreI ptr3
			Output
			ptrloop2,Load ptr1
			Add One
			Store ptr1
			Load ptr2
			Add One
			Store ptr2
			Load ptr3
			Add One
			Store ptr3
			Load Zero
			store tempptr1
			Store tempptr2
			LoadI ptr1
			Store tempptr1
			LoadI ptr2
			Store tempptr2
			Load tempptr1
			Subt tempptr2
			StoreI ptr3
			Output
			LoadI ptr1
			SkipCond 400
			jump ptrloop2
			Jump ENDIF12
ENDIF12,Halt

/...............................................................

IF13,       Load UserInput
          	Subt Thirteen
          	SkipCond 400
          	Jump IF14
			LoadI ptr1
			store tempptr1
			LoadI ptr2
			Store tempptr2
			Load Zero
			Store y
			Store Total
		loopMult22,Load y
				 Subt tempptr2
				 SkipCond 000
				 Jump Summulti22
				 	Load Total
				 	Add tempptr1
				 	Store Total
				 	Load y
				 	Add One
				 	Store y
					Jump loopMult22
		Summulti22,Load Total
			StoreI ptr3
			Output
			ptrloop3,Load ptr1
			Add One
			Store ptr1
			Load ptr2
			Add One
			Store ptr2
			Load ptr3
			Add One
			Store ptr3
			Load Zero
			store tempptr1
			Store tempptr2
			LoadI ptr1
			Store tempptr1
			LoadI ptr2
			Store tempptr2
			Load Zero
			Store y
			Store Total
		loopMult223,Load y
				 Subt tempptr2
				 SkipCond 000
				 Jump Summulti223
				 	Load Total
				 	Add tempptr1
				 	Store Total
				 	Load y
				 	Add One
				 	Store y
					Jump loopMult223
		Summulti223,Load Total
			StoreI ptr3
			Output
			LoadI ptr1
			SkipCond 400
			jump ptrloop3
			Jump ENDIF13
ENDIF13,Halt

