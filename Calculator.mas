Input
Store UserInput

/...............................................................

IF1,Load UserInput
	Subt One
	SkipCond 400
	Jump IF2
		Input
		Store x
		Input
		Store y
		Load x
		Add y
		Store sum
		Output
EndIF1,Halt

/...............................................................

IF2, Load UserInput
	 Subt Two
	 SkipCond 400
	 Jump IF3
	 	Input
		Store x
		Input
		Store y
		Load x
		Subt y
		Store sum
		Output
ENDIF2,Halt

/...............................................................

IF3,Load UserInput
	Subt Three
	SkipCond 400
	Jump IF4
		Input
		Store x
		Input
		Store times
				Load Zero
				Store y
				Store Total
		loopMult,Load y
				 Subt times
				 SkipCond 000
				 Jump Summulti
				 	Load Total
				 	Add x
				 	Store Total
				 	Load y
				 	Add One
				 	Store y
					Jump loopMult
		Summulti,Load Total
				Output
ENDIF3,Halt

/...............................................................

IF4,Load UserInput
	Subt Four
	SkipCond 400
	Jump IF5
	Input
	Store x
	Input
	Store y
	LoopDivision,Load x
				Subt y
				Store x
				SkipCond 800
					Jump SumLoopDivision
				Load counter
				Add One
				Store counter
				Jump LoopDivision
	SumLoopDivision,Load counter
					Output
ENDIF4,Halt

/...............................................................

IF5,Load UserInput
	Subt Five
	SkipCond 400
	Jump IF6
            Input
            Store x
            Input
            Store y
LoopModulo, Load x
            Subt y
            SkipCond 000
                Jump StoreAndContinue
            Load x
            Output
            Halt
StoreAndContinue, Store x
                  Jump LoopModulo
ENDIF5,Halt

/...............................................................

IF6, Load UserInput
     Subt Six
     SkipCond 400
     Jump IF7
     Load Zero
     Store SumArray
     Load Adder
     Store Next
     Load Num
     Store counter2
Loopsumarray, Load counter2
      SkipCond 800
      Jump EndLoopsumarray
      Load SumArray
      AddI Next
      Store SumArray
      Load Next
      Add One
      Store Next
      Load counter2
      Subt One
      Store counter2
      Jump Loopsumarray
EndLoopsumarray, Load SumArray
         Output
ENDIF6,  Halt

/...............................................................

IF7, Load UserInput
     Subt Seven
     SkipCond 400
     Jump IF8
     Load Zero
     Store SumArray
     Load Adder
     Store Next
     Load Num
     Store counter2
Loopavgarray, Load counter2
      SkipCond 800
      Jump DivAvg
      Load SumArray
      AddI Next
      Store SumArray
      Load Next
      Add One
      Store Next
      Load counter2
      Subt One
      Store counter2
      Jump Loopavgarray
DivAvg, Load Zero
        Store counter
LoopDivAvg, Load SumArray
            Subt Num
            SkipCond 000
            Jump ContinueDiv
            Jump EndLoopavgarray
ContinueDiv, Store SumArray
             Load counter
             Add One
             Store counter
             Jump LoopDivAvg
EndLoopavgarray, Load counter
                 Output
ENDIF7,  Halt

/...............................................................

IF8,      Load UserInput
          Subt Eight
          SkipCond 400
          Jump IF9
          Load Adder
          Store Next
          Load Num
          Store counter
          LoadI Next
          Store MAXVALUE
myLoop,   Load counter
          Subt One
          Store counter
          SkipCond 800
          Jump ENDIF8
          Load Next
          Add One
          Store Next
          LoadI Next
          Store temp
          Subt MAXVALUE
          SkipCond 800
          Jump myLoop
          Load temp
          Store MAXVALUE
          Jump myLoop
ENDIF8,   Load MAXVALUE
          Output
          Halt

/...............................................................

IF9,      Load UserInput
          Subt Nine
          SkipCond 400
          Jump IF10
		  Load Adder
          Store Next
          Load Num
          Store counter
		  LoadI Next
		  Store MINVALUE
		myloop2,Load counter
				Subt One
				Store counter
				SkipCond 800
				Jump ENDIF9
				Load Next
				Add One
				Store Next
				LoadI Next
				Store temp
				Subt MINVALUE
				SkipCond 000
				Jump myloop2
				Load temp
				Store MINVALUE
				Jump myloop2
ENDIF9,Load MINVALUE
Output
Halt

/...............................................................

IF10,       Load UserInput
          	Subt Ten
          	SkipCond 400
          	Jump IF11
			Load Adder
			Store Next
			Load Num
			Store counter
			LoadI Next
			Store x
			Store times
			Load Zero
				Store y
				Store Total
		loopMult2,Load y
				 Subt times
				 SkipCond 000
				 Jump Summulti2
				 	Load Total
				 	Add x
				 	Store Total
				 	Load y
				 	Add One
				 	Store y
					Jump loopMult2
		Summulti2,Load Total
			      Store myNorm
		mynormloop,Load counter
					Subt One
					Store counter
					SkipCond 800
					Jump ENDIF10
					Load Next
					Add One
					Store Next
					Store times
					LoadI Next
			Store x
			Store times
			Load Zero
				Store y
				Store Total
		loopMult3,Load y
				 Subt times
				 SkipCond 000
				 Jump Summulti3
				 	Load Total
				 	Add x
				 	Store Total
				 	Load y
				 	Add One
				 	Store y
					Jump loopMult3
		Summulti3,Load Total
					Add myNorm
					Store myNorm
					Jump mynormloop
ENDIF10,    Load myNorm
            Store Remainder
            Load One
            Store Odd
            Load Zero
            Store Root
SqrtLoop,   Load Remainder
            Subt OddNum
            SkipCond 000
            Jump KeepGoing
            Jump PrintResult
KeepGoing,  Store Remainder
            Load Root
            Add One
            Store Root
            Load OddNum
            Add Two
            Store OddNum
            Jump SqrtLoop
PrintResult,Load Root
Output
Halt

/...............................................................

IF11,       Load UserInput
          	Subt Eleven
          	SkipCond 400
          	Jump IF12
			LoadI ptr1
			AddI ptr2
			StoreI ptr3
			Output
			ptrloop,Load ptr1
			Add One
			Store ptr1
			Load ptr2
			Add One
			Store ptr2
			Load ptr3
			Add One
			Store ptr3
			LoadI ptr1
			AddI ptr2
			StoreI ptr3
			Output
			LoadI ptr1
			SkipCond 400
			jump ptrloop
			Jump ENDIF11
ENDIF11,Halt

